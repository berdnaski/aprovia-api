# ── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:5173

# ── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://admin:admin@localhost:5432/db_aprovai?schema=public"

# ── Redis (filas BullMQ) ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# Agendador (RN31/RN32, RF31). Deixe "false" nas réplicas extras: com mais de
# um processo, todas disparariam os mesmos crons.
SCHEDULER_ENABLED=true

# ── Autenticação ─────────────────────────────────────────────────────────────
JWT_SECRET=troque-em-producao
JWT_EXPIRES_IN=900
REFRESH_TOKEN_SECRET=troque-em-producao
REFRESH_TOKEN_EXPIRES_IN=604800

# ── E-mail (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM="Aprovia <nao-responda@exemplo.com.br>"

# ── Storage de anexos (Cloudflare R2, compatível com S3) ─────────────────────
# Painel Cloudflare → R2 → Manage API Tokens → Create API Token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aprovia-anexos
# Validade da URL assinada de download, em segundos (15 min)
R2_SIGNED_URL_TTL_SECONDS=900
# Tamanho máximo de anexo, em bytes (10 MB)
UPLOAD_MAX_SIZE_BYTES=10485760

# ── Consulta de CNPJ (BrasilAPI) ─────────────────────────────────────────────
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
# RNF14: falhou em 3s, cai para preenchimento manual sem travar o pedido
BRASIL_API_TIMEOUT_MS=3000

# ── Extração assistida por IA (DeepSeek) ─────────────────────────────────────
# Vazio desativa a extração: o formulário manual segue funcionando (RNF13)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_EXTRACTION_TIMEOUT_MS=20000
