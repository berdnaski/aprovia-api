# Copie para .env e ajuste os valores.
#   cp .env.example .env

# ─── Banco de dados ───────────────────────────────────────────
# Credenciais conforme docker-compose.yml
DATABASE_URL="postgresql://admin:admin@localhost:5432/db_aprovai?schema=public"

# ─── Redis (fila BullMQ) ──────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379

# ─── Aplicação ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL="http://localhost:5173"

# ─── Autenticação (RNF06) ─────────────────────────────────────
# Gere com: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN=900
REFRESH_TOKEN_SECRET=""
REFRESH_TOKEN_EXPIRES_IN=604800

# ─── Integrações (etapas posteriores) ─────────────────────────
# RESEND_API_KEY=""
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
